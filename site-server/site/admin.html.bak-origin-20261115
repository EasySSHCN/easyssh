    /* ---------- v5.1.4:顶部统计卡片明细弹窗(累计设备数/近7天活跃/近24小时活跃 → 设备记录列表) ---------- */
    var topState = { window: "all", title: "", page: 1, pageSize: 10 };
    function topEnsureModal() {
