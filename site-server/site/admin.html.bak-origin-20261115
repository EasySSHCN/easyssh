      $("rec-sel-all").indeterminate = n > 0 && n < boxes.length;
    }
    /* v5.1.5 重构:recOpen(cfg) 显式传入完整唯一检索上下文(mode/参数/标题),不再依赖共享可变状态的残留值;
       全部弹窗链接的点击处理器统一走此入口,杜绝跨链接的模式串扰(如 IP 模式残留导致地域取值被送错接口) */
    function recOpen(cfg) {
      recEnsureModal();
      recState.mode = cfg.mode;
      recState.bucket = cfg.bucket || "";
      recState.value = cfg.value;
      recState.label = cfg.label || cfg.value || "";
      recState.extra = cfg.extra === undefined ? null : cfg.extra;
      recState.page = 1;
      $("recModal").style.display = "flex";
      $("rec-title").textContent = recState.label + " — 设备明细";
      recLoad();
    }
    function recLoad() {
      $("rec-list").innerHTML = '<p style="color:#8fa3b8;">加载中…</p>';
      /* 动态记录三个链接复用本弹窗:mode=anon 按设备ID检索单台;mode=ip 按掩码IP前缀检索多台(客户端分页);默认 bucket 按分布维度 */
      if (recState.mode === "time") {
        /* 时间链接:同一秒内可能有多台设备上报,列出该时间的所有动态记录(每条 = 对应设备的详细记录卡片) */
        stApi({ action: "devices_by_time", user: state.user, token: state.token, ts: parseInt(recState.value, 10) || 0 })
          .then(function (j) {
            if (!j.ok) { $("rec-list").innerHTML = '<p style="color:#ff6b6b;">' + esc(j.message || "加载失败") + '</p>'; $("rec-pager").innerHTML = ""; return; }
            var rows = j.rows || [];
            recState.total = rows.length;
            recState.rows = rows.slice((recState.page - 1) * recState.pageSize, recState.page * recState.pageSize);
            if (!recState.rows.length) { $("rec-list").innerHTML = '<p style="color:#8fa3b8;">该时间暂无动态记录（流水仅保留最新 500 条）</p>'; $("rec-pager").innerHTML = ""; return; }
            $("rec-list").innerHTML = recState.rows.map(function (r) {
              var head = '<div class="meta" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><b>🕘 上报时间：' + esc(new Date(r.t || 0).toLocaleString()) + '</b>' +
                (r.v ? ' · <span style="color:var(--accent);">v' + esc(r.v) + '</span>' : '') +
                (r.anonId ? ' · 设备 ' + esc(String(r.anonId).slice(0, 12)) + '…' : '') + '</div>';
              var card = r.device ? deviceItemHtml(r.device, { canEdit: true })
                : '<p style="color:#8fa3b8;">该设备的统计档案已被删除，仅剩流水记录</p>';
              return head + card + '<hr style="border:none;border-top:1px dashed var(--border);margin:10px 0;" />';
            }).join("");
            recRenderPager();
          }).catch(function () { $("rec-list").innerHTML = '<p style="color:#ff6b6b;">加载失败，请重试</p>'; });
        return;
      }
      if (recState.mode === "anonlog") {
        /* 上报N次:按设备ID检索其全部上报流水,每条上报 = 上报时间/版本 + 该设备完整详细记录卡片 */
        var pDev = recState.extra ? Promise.resolve({ ok: true, row: recState.extra })
          : stApi({ action: "device", user: state.user, token: state.token, anonId: recState.value });
        Promise.all([
          pDev,
          stApi({ action: "device_log", user: state.user, token: state.token, anonId: recState.value, page: recState.page, pageSize: recState.pageSize })
        ]).then(function (rs) {
          var jDev = rs[0], jLog = rs[1];
          if (!jLog.ok) { $("rec-list").innerHTML = '<p style="color:#ff6b6b;">' + esc(jLog.message || "加载失败") + '</p>'; $("rec-pager").innerHTML = ""; return; }
          if (jDev.ok && jDev.row) recState.extra = jDev.row;
          var devRow = recState.extra;
          var rows = jLog.rows || [];
          recState.total = jLog.total || 0;
          if (!rows.length || !devRow) {
            $("rec-list").innerHTML = '<p style="color:#8fa3b8;">暂无上报流水（全局流水仅保留最新 500 条；功能上线前（2026-11-13 之前）的上报未生成流水记录）' + (!devRow ? '；设备档案已被删除' : '') + '</p>';
