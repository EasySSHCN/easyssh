    function totalPages() { return Math.max(1, Math.ceil(state.items.length / state.pageSize)); }

    function renderList() {
      var box = $("fb-list");
      $("fb-total").textContent = "共 " + state.items.length + " 条反馈";
      if (!state.items.length) {
        box.innerHTML = '<p style="color:#8fa3b8;">暂无反馈</p>';
        $("fb-pager").innerHTML = "";
        return;
      }
      if (state.page > totalPages()) state.page = totalPages();
      var slice = state.items.slice((state.page - 1) * state.pageSize, state.page * state.pageSize);
      box.innerHTML = slice.map(itemHtml).join("");
      renderPager();
      updateBatchState();
