        }
        var actBtn = e.target.closest("[data-act]");
        if (!actBtn) return;
        var item2 = actBtn.closest(".fb-item");
        var form2 = item2.querySelector("[data-editform]");
        if (!form2) return;
        if (actBtn.getAttribute("data-act") === "ecancel") { form2.style.display = "none"; return; }
        if (actBtn.getAttribute("data-act") !== "esave") return;
        var fields = {};
        var inputs = form2.querySelectorAll("input[data-ef]");
        inputs.forEach(function (inp) {
          var v = inp.value.trim();
          if (v !== "") fields[inp.getAttribute("data-ef")] = v;
        });
        stApi({ action: "update", user: state.user, token: state.token, anonId: item2.getAttribute("data-anon"), fields: fields })
          .then(function (j) {
            if (j.ok) { stMsg("已保存"); recLoad(); }
            else stMsg(j.message || "保存失败", true);
          }).catch(function () { stMsg("网络错误，请重试", true); });
      });
