<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>后台管理 — EasySSH</title>
  <meta name="robots" content="noindex,nofollow">
  <link rel="icon" type="image/svg+xml" href="assets/img/logo.svg">
  <link rel="stylesheet" href="assets/css/style.css">
  <style>
    .fb-wrap { max-width: 1080px; margin: 0 auto; }

    /* ---- 登录卡片 ---- */
    #login-box {
      max-width: 380px; margin: 40px auto 0; padding: 28px 28px 24px;
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: var(--radius); box-shadow: var(--shadow);
    }
    #login-box label { display: block; margin-top: 14px; font-size: 14px; color: var(--text-dim); }
    #login-box input {
      width: 100%; box-sizing: border-box; margin-top: 6px; padding: 9px 12px;
      font: inherit; color: var(--text); background: var(--bg-term);
      border: 1px solid var(--border); border-radius: var(--radius-sm); outline: none;
    }
    #login-box input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-dim); }
    #login-msg { color: var(--red) !important; }

    /* ---- 顶部标签页 ---- */
    .admin-tabs {
      display: flex; gap: 8px; margin-bottom: 18px; flex-wrap: wrap;
      border-bottom: 1px solid var(--border); padding-bottom: 10px;
    }
    .admin-tabs button {
      cursor: pointer; padding: 7px 20px; font: inherit; font-size: 15px;
      border-radius: var(--radius-sm); border: 1px solid var(--border-strong);
      background: var(--bg-soft); color: var(--text); transition: all .15s ease;
    }
    .admin-tabs button:hover { border-color: var(--accent); color: var(--accent); }
    .admin-tabs button.on {
      background: var(--accent); color: #06120b; border-color: var(--accent); font-weight: 600;
    }
    .tab-panel { display: none; }
    .tab-panel.on { display: block; }

    /* ================= 统计看板 ================= */
    .stats-cards { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 20px; }
    /* v5.1.4:全部卡片悬停边框高亮(统计卡片/分布卡片/列表条目通用) */
    .stat-card, .dist-card, .fb-item { transition: border-color .15s ease; }
    .stat-card:hover, .dist-card:hover, .fb-item:hover { border-color: var(--accent); }
    .stat-card {
      flex: 1; min-width: 160px; padding: 16px 20px; background: var(--bg-card);
      border: 1px solid var(--border); border-radius: var(--radius); text-align: center;
    }
    .stat-card .num { font-size: 30px; font-weight: 700; color: var(--accent); }
    .stat-card .label { font-size: 13px; color: var(--text-dim); margin-top: 4px; }
    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
    @media (max-width: 1280px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 700px) { .stats-grid { grid-template-columns: 1fr; } }
    .dist-card {
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 16px 18px;
    }
    .dist-card h3 { margin: 0 0 10px; font-size: 14px; color: var(--text); }
    .dist-link { cursor: pointer; transition: color .15s ease; }
    .dist-link:hover { color: var(--accent); }
    /* 分布详细列表弹窗 */
    #distModal { position: fixed; inset: 0; background: rgba(0,0,0,.6); z-index: 220; display: none; align-items: center; justify-content: center; }
    #distModal .dist-panel {
      width: 640px; max-width: 94vw; max-height: 86vh; display: flex; flex-direction: column;
      background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius);
      box-shadow: var(--shadow); position: relative; padding: 22px 24px;
    }
    #distModal h3 { margin: 0 0 12px; font-size: 15px; color: var(--text); }
    #dist-table-wrap { overflow-y: auto; min-height: 60px; }
    /* v5.1.5:「全部提交动态」/「上报明细」弹窗(与分布弹窗同款遮罩+面板;此前缺 id 规则导致弹层渲染在文档底部、点击看似无反应) */
    #stlogModal, #strepModal, #stipModal { position: fixed; inset: 0; background: rgba(0,0,0,.6); z-index: 220; display: none; align-items: center; justify-content: center; } /* strep/stip 已废弃,保留选择器仅为兼容旧缓存 */
    #stlogModal .dist-panel, #strepModal .dist-panel, #stipModal .dist-panel {
      width: 640px; max-width: 94vw; max-height: 86vh; display: flex; flex-direction: column;
      background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius);
      box-shadow: var(--shadow); position: relative; padding: 22px 24px;
    }
    #stlogModal h3, #strepModal h3, #stipModal h3 { margin: 0 0 12px; font-size: 15px; color: var(--text); }
    #stlogm-list, #strep-list, #stip-list { overflow-y: auto; min-height: 60px; }
    #stlogm-pager, #strep-pager { margin-top: 12px; }
    /* v5.1.4:顶部统计卡片明细弹窗(复用分布弹窗面板样式) */
    #topModal { position: fixed; inset: 0; background: rgba(0,0,0,.6); z-index: 220; display: none; align-items: center; justify-content: center; }
    #topModal .dist-panel {
      width: 760px; max-width: 94vw; max-height: 88vh; display: flex; flex-direction: column;
      background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius);
      box-shadow: var(--shadow); position: relative; padding: 22px 24px;
    }
    #topModal h3 { margin: 0 0 12px; font-size: 15px; color: var(--text); }
    #top-table-wrap { overflow-y: auto; min-height: 60px; }
    /* v5.1.4:访客明细弹窗(卡片/TOP10 联动) */
    #visitModal { position: fixed; inset: 0; background: rgba(0,0,0,.6); z-index: 230; display: none; align-items: center; justify-content: center; }
    #visitModal .dist-panel {
      width: 860px; max-width: 94vw; max-height: 88vh; display: flex; flex-direction: column;
      background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius);
      box-shadow: var(--shadow); position: relative; padding: 22px 24px;
    }
    #visitModal h3 { margin: 0 0 12px; font-size: 15px; color: var(--text); }
    #visit-wrap { overflow-y: auto; min-height: 60px; }
    .dist-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .dist-table th, .dist-table td {
      text-align: left; padding: 7px 10px; border-bottom: 1px solid var(--border);
      color: var(--text); word-break: break-all; overflow-wrap: anywhere;
    }
    .dist-table th { color: var(--text-dim); font-weight: 600; font-size: 12.5px; position: sticky; top: 0; background: var(--bg-card); }
    .dist-table td.num, .dist-table th.num { text-align: right; width: 90px; white-space: nowrap; }
    #dist-pager { margin-top: 12px; }
    .bar-row { display: flex; align-items: center; gap: 8px; margin-top: 6px; font-size: 12.5px; }
    .bar-row .bar-label { width: 40%; color: var(--text-dim); word-break: break-all; overflow-wrap: anywhere; }
    .bar-row .bar-track { flex: 1; height: 10px; background: var(--bg-soft); border-radius: 999px; overflow: hidden; }
    .bar-row .bar-fill { display: block; height: 100%; background: var(--accent); border-radius: 999px; }
    .bar-row .bar-num { width: 46px; text-align: right; color: var(--text); flex: none; }
    .bar-num a.num-link, .stat-card a.num-link { color: var(--accent); text-decoration: none; cursor: pointer; }
    .bar-num a.num-link:hover, .stat-card a.num-link:hover { text-decoration: underline; filter: brightness(1.2); }
    /* 分布维度设备明细弹窗(弹层内复用 fb-item / sysinfo 样式) */
    #recModal { position: fixed; inset: 0; background: rgba(0,0,0,.6); z-index: 225; display: none; align-items: center; justify-content: center; }
    #recModal .dist-panel { width: 760px; max-width: 94vw; max-height: 88vh; display: flex; flex-direction: column;
      background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius);
      box-shadow: var(--shadow); position: relative; padding: 22px 24px; }
    #rec-modal-toolbar { margin-bottom: 8px; font-size: 13px; }
    .fb-item .edit-form { margin-top: 10px; border-top: 1px dashed var(--border); padding-top: 10px; }
    .fb-item .edit-form label { display: block; margin-top: 8px; font-size: 13px; color: var(--text-dim); }
    .fb-item .edit-form input[type=text] {
      width: 100%; box-sizing: border-box; font: inherit; padding: 7px 10px; margin-top: 4px;
      border: 1px solid var(--border); border-radius: var(--radius-sm);
      background: var(--bg-term); color: var(--text); outline: none;
    }
    .fb-item .edit-form input[type=text]:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-dim); }
    .trend-card { grid-column: 1 / -1; }
    .trend-row { display: flex; align-items: flex-end; gap: 3px; height: 90px; margin-top: 8px; }
    .trend-col { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; min-width: 0; }
    .trend-col .t-bar { width: 100%; max-width: 18px; background: var(--accent); border-radius: 3px 3px 0 0; min-height: 2px; }
    .trend-col .t-date { font-size: 9.5px; color: var(--text-dim); margin-top: 4px; white-space: nowrap; overflow: hidden; max-width: 100%; }
    .stats-toolbar { display: flex; gap: 10px; align-items: center; justify-content: space-between; flex-wrap: wrap; margin: 24px 0 8px; }
    .stats-toolbar h2 { font-size: 16px; margin: 0; }
    .stats-toolbar button, #btn-refresh, #btn-logout, #btn-changepwd, #btn-emailset {
      cursor: pointer; padding: 5px 14px; border-radius: var(--radius-sm);
      border: 1px solid var(--border-strong); background: var(--bg-soft);
      color: var(--text); font: inherit; font-size: 14px; transition: all .15s ease;
    }
    .stats-toolbar button:hover, #btn-refresh:hover, #btn-logout:hover, #btn-changepwd:hover, #btn-emailset:hover { border-color: var(--accent); color: var(--accent); }
    .stats-toolbar button.danger { color: var(--red); border-color: rgba(255,107,107,.5); background: transparent; }
    .stats-toolbar button.danger:hover { background: rgba(255,107,107,.1); border-color: var(--red); }

    /* ================= 反馈管理（自 feedback-admin 迁入） ================= */
    .fb-item {
      border: 1px solid var(--border); border-left: 3px solid var(--border-strong);
      border-radius: var(--radius); padding: 18px 20px; margin-top: 16px;
      background: var(--bg-card);
    }
    .fb-item:hover { border-left-color: var(--accent); }
    .fb-item .meta { color: var(--text-dim); font-size: 13px; margin-top: 6px; word-break: break-all; overflow-wrap: anywhere; }
    .fb-item .content {
      margin-top: 10px; white-space: pre-wrap; color: var(--text);
      background: var(--bg-soft); border: 1px solid var(--border);
      border-radius: var(--radius-sm); padding: 10px 14px;
      word-break: break-all; overflow-wrap: anywhere; max-width: 100%; box-sizing: border-box; overflow: hidden;
    }
    .fb-item details.sysinfo {
      margin-top: 10px; font-size: 13px; border: 1px solid var(--border);
      border-radius: var(--radius-sm); background: var(--bg-soft);
    }
    .fb-item details.sysinfo summary { cursor: pointer; padding: 6px 12px; color: var(--cyan); user-select: none; }
    .fb-item details.sysinfo[open] summary { border-bottom: 1px solid var(--border); }
    .sysinfo-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
    .sysinfo-table td {
      padding: 4px 12px; vertical-align: top; color: var(--text);
      border-bottom: 1px solid var(--border); word-break: break-all; overflow-wrap: anywhere; max-width: 100%;
    }
    .sysinfo-table td:first-child { color: var(--text-dim); white-space: nowrap; width: 120px; }
    .sysinfo-table tr:last-child td { border-bottom: none; }
    .fb-item .reply-box { margin-top: 14px; }
    .fb-item .reply-box label { font-size: 13px; color: var(--text-dim); }
    .fb-item textarea, .fb-item input[type=text],
    .fb-form input[type=text], .fb-form textarea, .fb-form select {
      width: 100%; box-sizing: border-box; font: inherit; padding: 8px 12px; margin-top: 6px;
      border: 1px solid var(--border); border-radius: var(--radius-sm);
      background: var(--bg-term); color: var(--text); outline: none;
    }
    .fb-item textarea:focus, .fb-item input[type=text]:focus,
    .fb-form input[type=text]:focus, .fb-form textarea:focus, .fb-form select:focus {
      border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-dim);
    }
    .fb-form select option { background: var(--bg-card); color: var(--text); }
    .fb-actions { margin-top: 12px; display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    /* 统一按钮风格:记录卡片/工具栏/弹窗内所有普通按钮与顶部「邮箱设置/修改账号/退出登录」一致 */
    .fb-actions button, .fb-item button, .fb-toolbar button, #st-list button, #em-send, #fp-send {
      cursor: pointer; padding: 5px 14px; border-radius: var(--radius-sm);
      border: 1px solid var(--border-strong); background: var(--bg-soft);
      color: var(--text); font: inherit; font-size: 14px; transition: all .15s ease;
    }
    .fb-actions button:hover, .fb-item button:hover, .fb-toolbar button:hover, #st-list button:hover,
    #em-send:hover, #fp-send:hover {
      border-color: var(--accent); color: var(--accent);
    }
    /* 统一点击(按下)反馈:轻微下沉 + 变暗,覆盖页面全部按钮 */
    .admin-tabs button:active, .fb-actions button:active, .fb-item button:active,
    .fb-toolbar button:active, #st-list button:active, .fb-pager button:active,
    .stats-toolbar button:active, #btn-refresh:active, #btn-logout:active,
    #btn-changepwd:active, #btn-emailset:active, #em-send:active, #fp-send:active {
      filter: brightness(.8);
      transform: translateY(1px);
    }
    .fb-actions button.primary { background: var(--accent); color: #06120b; border-color: var(--accent); font-weight: 600; }
    .fb-actions button.primary:hover { filter: brightness(1.1); color: #06120b; }
    /* 最近上报设备列表内的按钮（如「删除」）：与站点统一按钮样式一致 */
    #st-list .fb-toolbar button {
      cursor: pointer; padding: 5px 14px; border-radius: var(--radius-sm);
      border: 1px solid var(--border-strong); background: var(--bg-soft);
      color: var(--text); font: inherit; font-size: 14px; transition: all .15s ease;
    }
    #st-list .fb-toolbar button:hover { border-color: var(--accent); color: var(--accent); }
    .fb-actions button.danger, .fb-toolbar button.danger, #btn-batch-del { color: var(--red); border-color: rgba(255,107,107,.5); background: transparent; }
    .fb-actions button.danger:hover, .fb-toolbar button.danger:hover:not(:disabled), #btn-batch-del:hover:not(:disabled) { background: rgba(255,107,107,.1); border-color: var(--red); }
    #btn-batch-del:disabled { opacity: .35; cursor: not-allowed; }
    #sel-all, .sel-item { width: 15px; height: 15px; accent-color: var(--red); cursor: pointer; }
    .modal-x {
      position: absolute; top: 10px; right: 14px; cursor: pointer;
      color: var(--text-dim); font-size: 20px; line-height: 1; user-select: none;
      transition: color .15s ease;
    }
    .modal-x:hover { color: var(--accent); }
    .fb-badge { display: inline-block; font-size: 12px; padding: 1px 10px; border-radius: 999px; border: 1px solid currentColor; margin-left: 6px; }
    .fb-badge.pub { color: var(--accent); }
    .fb-badge.new { color: var(--yellow); }
    .fb-form {
      border: 1px solid var(--border); border-radius: var(--radius);
      padding: 20px 22px; margin-top: 28px; background: var(--bg-card);
    }
    .fb-form .fb-form { border: none; background: transparent; padding: 0; margin-top: 8px; }
    .fb-form label { display: block; margin-top: 14px; font-size: 14px; color: var(--text-dim); }
    .fb-form label:has(input[type=checkbox]) { display: flex; gap: 8px; align-items: center; color: var(--text); }
    .fb-form input[type=checkbox] { width: 16px; height: 16px; accent-color: var(--accent); }
    .fb-form .fb-actions { margin-top: 16px; }
    .fb-msg { margin-top: 10px; font-size: 14px; min-height: 20px; }
    .fb-toolbar { display: flex; gap: 10px; align-items: center; justify-content: space-between; flex-wrap: wrap; margin-bottom: 8px; color: var(--text-dim); font-size: 15px; }
    .fb-pager {
      display: flex; gap: 14px; align-items: center; justify-content: space-between;
      flex-wrap: wrap; margin-top: 18px; padding: 12px 16px;
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: var(--radius); color: var(--text-dim); font-size: 14px;
    }
    .fb-pager .pg-btns { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
    .fb-pager button {
      cursor: pointer; padding: 4px 12px; font: inherit; font-size: 13px;
      border-radius: var(--radius-sm); border: 1px solid var(--border-strong);
      background: var(--bg-soft); color: var(--text); transition: all .15s ease;
    }
    .fb-pager button:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }
    .fb-pager button:disabled { opacity: .35; cursor: not-allowed; }
    .fb-pager button.pg-cur { background: var(--accent); color: #06120b; border-color: var(--accent); font-weight: 600; }
    .fb-pager .pg-dots { color: var(--text-dim); padding: 0 2px; }
    .fb-pager .pg-size { display: flex; gap: 8px; align-items: center; color: var(--text-dim); }
    .fb-pager .pg-size input {
      width: 70px; padding: 4px 8px; font: inherit; text-align: center;
      color: var(--text); background: var(--bg-term);
      border: 1px solid var(--border); border-radius: var(--radius-sm); outline: none;
    }
    .fb-pager .pg-size input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-dim); }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="container nav">
      <a class="brand" href="index.html">
        <img class="logo" src="assets/img/logo.svg" alt="EasySSH logo">
        EasySSH<span class="cursor-blink">_</span>
      </a>
      <nav class="nav-links"><a href="download.html">← 返回下载页</a></nav>
    </div>
  </header>

  <main class="section">
    <div class="container fb-wrap">
      <h1 class="section-title">官网后台管理</h1>

      <!-- 登录区 -->
      <div id="login-box">
        <form id="login-form">
          <label style="display:block;margin-top:10px;">用户名
            <input type="text" id="login-user" autocomplete="username" required />
          </label>
          <label style="display:block;margin-top:10px;">密码
            <input type="password" id="login-pass" autocomplete="current-password" required />
          </label>
          <label style="display:block;margin-top:10px;">图形验证码
            <span style="display:flex;gap:8px;align-items:stretch;margin-top:6px;">
              <input type="text" id="login-captcha" maxlength="6" autocomplete="off" required style="flex:1;min-width:0;" />
              <img id="captcha-img" alt="验证码" title="看不清?点击刷新" style="height:40px;width:132px;flex:none;border-radius:var(--radius-sm);border:1px solid var(--border);cursor:pointer;background:var(--bg-term);" />
            </span>
          </label>
          <button type="submit" class="btn btn-primary" style="margin-top:16px;width:100%;">登录</button>
          <div style="margin-top:10px;text-align:right;">
            <a href="#" id="fp-link" style="color:var(--cyan);font-size:13px;text-decoration:none;">忘记密码?</a>
          </div>
          <div id="login-msg" class="fb-msg" style="color:#dc2626;"></div>
        </form>
      </div>

      <!-- 找回密码弹窗 -->
      <div id="fpModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:210;align-items:center;justify-content:center;">
        <div style="width:400px;max-width:92vw;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:24px 26px;box-shadow:var(--shadow);position:relative;">
          <span class="modal-x" id="fp-close" title="关闭">×</span>
          <h3 style="margin:0 0 4px;">找回密码</h3>
          <p style="margin:0 0 10px;font-size:12px;color:var(--text-dim);">需填写<b>用户名</b>与<b>已绑定的邮箱</b>。验证码将发送到绑定邮箱,15 分钟内有效。</p>
          <label style="display:block;margin-top:10px;font-size:14px;color:var(--text-dim);">用户名
            <input type="text" id="fp-user" autocomplete="username" style="width:100%;box-sizing:border-box;margin-top:6px;padding:9px 12px;font:inherit;color:var(--text);background:var(--bg-term);border:1px solid var(--border);border-radius:var(--radius-sm);outline:none;" />
          </label>
          <label style="display:block;margin-top:10px;font-size:14px;color:var(--text-dim);">绑定邮箱
            <input type="email" id="fp-email" autocomplete="email" style="width:100%;box-sizing:border-box;margin-top:6px;padding:9px 12px;font:inherit;color:var(--text);background:var(--bg-term);border:1px solid var(--border);border-radius:var(--radius-sm);outline:none;" />
          </label>
          <div style="margin-top:10px;">
            <button type="button" id="fp-send">发送验证码</button>
            <span id="fp-cd" style="margin-left:8px;font-size:12px;color:var(--text-dim);"></span>
          </div>
          <label style="display:block;margin-top:10px;font-size:14px;color:var(--text-dim);">邮箱验证码
