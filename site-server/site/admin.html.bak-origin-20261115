    function renderPager() {
      var pages = totalPages();
      var btn = function (label, page, opts) {
        opts = opts || {};
        var dis = (opts.disabled || page < 1 || page > pages) ? " disabled" : "";
        var cur = opts.current ? ' class="pg-cur"' : "";
        return '<button type="button" data-page="' + page + '"' + dis + cur + '>' + label + '</button>';
      };
      var nums = "";
      for (var p = 1; p <= pages; p++) {
        if (pages > 9 && p > 2 && p < pages - 1 && Math.abs(p - state.page) > 1) {
          if (nums.slice(-3) !== "…" ) nums += "<span class='pg-dots'>…</span>";
          continue;
        }
        nums += btn(String(p), p, { current: p === state.page });
      }
      $("fb-pager").innerHTML =
        '<span class="pg-info">第 ' + state.page + ' / ' + pages + ' 页 · 本页 ' +
        state.items.slice((state.page - 1) * state.pageSize, state.page * state.pageSize).length + ' 条</span>' +
        '<span class="pg-btns">' + btn("« 首页", 1, { disabled: state.page === 1 }) +
        btn("‹ 上一页", state.page - 1, { disabled: state.page === 1 }) +
        nums +
        btn("下一页 ›", state.page + 1, { disabled: state.page === pages }) +
        btn("末页 »", pages, { disabled: state.page === pages }) + '</span>' +
        '<label class="pg-size">每页 <input type="number" id="pg-size" min="1" max="200" value="' + state.pageSize + '" /> 条</label>';
    }

