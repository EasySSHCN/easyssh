    function recUpdateBatch() {
      var n = recSelectedIds().length;
      var boxes = document.querySelectorAll("#rec-list .sel-item");
      var btn = $("rec-batch-del");
      btn.disabled = n === 0;
      btn.textContent = "删除选中（" + n + "）";
