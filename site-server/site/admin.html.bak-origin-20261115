    function loadCaptcha() {
      return get("api/captcha/img.php?t=" + Date.now()).then(function (j) {
        if (!j.ok) {
          // 频控(429)等失败:清掉旧图避免破图,按服务端返回的秒数即时倒数,归零自动重试
          captchaId = "";
          $("captcha-img").removeAttribute("src");
          var mm = /请\s*(\d+)\s*秒/.exec(j.message || "");
          if (mm) { startCaptchaCountdown(parseInt(mm[1], 10)); return; }
          $("login-msg").style.color = "#ff6b6b";
          $("login-msg").textContent = j.message || "验证码加载失败,请稍后重试";
          // 60 秒后若仍停留在登录页且未拿到新验证码,自动重试一次
          setTimeout(function () {
            if (!captchaId && $("login-box").style.display === "") {
              $("login-msg").textContent = "";
              loadCaptcha();
            }
          }, 60000);
          return;
        }
        captchaId = j.id;
        $("captcha-img").src = j.img;
        $("login-captcha").value = "";
      }).catch(function () {});
    }
