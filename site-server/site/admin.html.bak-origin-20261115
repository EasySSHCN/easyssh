    /* 弹窗内「台数」链接:与外层卡片台数链接同款,打开对应取值的设备明细弹窗(事件委托,取值时 recState 已定义) */
    document.addEventListener("click", function (e) {
      var a = e.target.closest("a[data-recdist]");
      if (!a) return;
      if (typeof recOpen !== "function") return;
      recOpen({
        mode: "bucket",
        bucket: a.getAttribute("data-recdist"),
        value: a.getAttribute("data-recvalue"),
        label: a.getAttribute("data-reclabel") || a.getAttribute("data-recvalue"),
        uid: a.getAttribute("data-uid")
      });
    });
    function distEntries(key) {
      var b = (lastSummary && lastSummary.full && lastSummary.full[key]) || {};
      return Object.keys(b).map(function (k) {
        return { name: key === "byLang" ? langDisp(k) : k, key: k, count: b[k] };
      });
    }
    function distRender() {
      var items = distEntries(distState.key);
      var pages = Math.max(1, Math.ceil(items.length / distState.pageSize));
      if (distState.page > pages) distState.page = pages;
      if (distState.page < 1) distState.page = 1;
      var from = items.length === 0 ? 0 : (distState.page - 1) * distState.pageSize + 1;
      var to = Math.min(items.length, distState.page * distState.pageSize);
      $("dist-title").textContent = distState.title + "（共 " + items.length + " 项）";
      var rows = items.slice((distState.page - 1) * distState.pageSize, distState.page * distState.pageSize)
        .map(function (it, i) {
          return '<tr><td class="num">' + (from + i) + '</td><td>' + esc(it.name) + '</td><td class="num"><a href="javascript:void(0)" class="num-link" data-recdist="' + esc(distState.key) + '" data-recvalue="' + esc(it.key) + '" data-reclabel="' + esc(it.name) + '" title="点击查看该取值下的设备明细列表">' + it.count + ' 台</a></td></tr>';
        }).join("");
      $("dist-table-wrap").innerHTML =
        '<table class="dist-table"><thead><tr><th class="num">#</th><th>名称 / 数值</th><th class="num">上报台数</th></tr></thead><tbody>' +
        (rows || '<tr><td colspan="3" style="color:#8fa3b8;">暂无数据</td></tr>') + '</tbody></table>';
      // 分页条：条数区间 + 按钮 + 每页条数
      var btn = function (label, page, dis, cur) {
        return '<button type="button" data-dpage="' + page + '"' + (dis ? " disabled" : "") +
          (cur ? ' class="pg-cur"' : "") + '>' + label + '</button>';
      };
      var nums = "";
      for (var p = 1; p <= pages; p++) {
        if (pages > 9 && p > 2 && p < pages - 1 && Math.abs(p - distState.page) > 1) {
          if (nums.slice(-24) !== "<span class='pg-dots'>…</span>") nums += "<span class='pg-dots'>…</span>";
          continue;
        }
        nums += btn(String(p), p, false, p === distState.page);
      }
      var sizes = [5, 10, 20, 50, 100];
      var opts = sizes.map(function (n) {
        return '<option value="' + n + '"' + (n === distState.pageSize ? " selected" : "") + '>' + n + ' 条/页</option>';
      }).join("");
      $("dist-pager").innerHTML =
        '<span class="pg-info">显示第 ' + from + ' - ' + to + ' 条 · 共 ' + items.length + ' 条 · 第 ' +
        distState.page + ' / ' + pages + ' 页</span>' +
        '<span class="pg-btns">' +
        btn("« 首页", 1, distState.page === 1, false) +
        btn("‹ 上一页", distState.page - 1, distState.page === 1, false) +
        nums +
        btn("下一页 ›", distState.page + 1, distState.page >= pages, false) +
        btn("末页 »", pages, distState.page >= pages, false) +
        '</span>' +
        '<span class="pg-size">每页 <select id="dist-page-size" style="padding:4px 8px;font:inherit;font-size:13px;color:var(--text);background:var(--bg-term);border:1px solid var(--border);border-radius:var(--radius-sm);outline:none;cursor:pointer;">' + opts + '</select></span>';
    }
    /* 卡片标题链接点击 → 打开全量取值聚合弹窗;数字链接点击 → 打开该取值设备明细弹窗 */
