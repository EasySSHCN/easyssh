    /* 可编辑的统计字段白名单(与服务端 update 动作一致;启动次数/首次上报/客户端类型不开放编辑) */
    var EDITABLE_FIELDS = ["软件版本", "操作系统", "CPU", "内存", "磁盘容量", "显卡", "系统语言代码", "地域"];

    /**
