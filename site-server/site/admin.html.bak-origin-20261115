      if (e.target.id !== "pg-size") return;
      var n = parseInt(e.target.value, 10);
      if (!isFinite(n) || n < 1) n = 1;
      if (n > 200) n = 200;
      state.pageSize = n;
      state.page = 1;
      try { localStorage.setItem("fb_page_size", String(n)); } catch (err) {}
      renderList();
    });

    function selectedIds() {
      return Array.prototype.slice.call(document.querySelectorAll("#fb-list .sel-item:checked"))
        .map(function (c) { return c.getAttribute("data-id"); });
    }
    function updateBatchState() {
      var n = selectedIds().length;
      var btn = $("btn-batch-del");
      btn.disabled = n === 0;
      btn.textContent = "删除选中（" + n + "）";
      var boxes = document.querySelectorAll("#fb-list .sel-item");
      $("sel-all").checked = boxes.length > 0 && n === boxes.length;
      $("sel-all").indeterminate = n > 0 && n < boxes.length;
    }
    $("fb-list").addEventListener("change", function (e) {
      if (e.target.classList && e.target.classList.contains("sel-item")) updateBatchState();
    });
    $("sel-all").addEventListener("change", function () {
      var on = $("sel-all").checked;
      document.querySelectorAll("#fb-list .sel-item").forEach(function (c) { c.checked = on; });
      updateBatchState();
    });
    $("btn-batch-del").addEventListener("click", function () {
      var ids = selectedIds();
      if (!ids.length) return;
      if (!confirm("确定删除选中的 " + ids.length + " 条反馈？此操作不可恢复。")) return;
      var btn = $("btn-batch-del");
      btn.disabled = true; btn.textContent = "删除中…";
      var done = 0, fail = 0;
      (function next() {
        if (done + fail >= ids.length) {
          msg(fail ? ("已删除 " + done + " 条，失败 " + fail + " 条") : ("已删除 " + done + " 条"), !!fail);
          loadList();
          return;
        }
        fbApi({ action: "delete", user: state.user, token: state.token, id: ids[done + fail] })
          .then(function (j) { j.ok ? done++ : fail++; })
          .catch(function () { fail++; })
          .then(next);
      })();
    });

    $("fb-list").addEventListener("click", function (e) {
      var btn = e.target.closest("[data-act]");
      if (!btn) return;
      var item = btn.closest(".fb-item");
      var id = item.getAttribute("data-id");
      var act = btn.getAttribute("data-act");
      var base = { user: state.user, token: state.token, id: id };
      if (act === "reply") {
        var reply = item.querySelector('[data-field="reply"]').value;
        fbApi(Object.assign({ action: "reply", reply: reply }, base)).then(function (j) { j.ok ? (msg("回复已保存"), loadList()) : msg(j.message || "失败", true); });
      } else if (act === "setpublic") {
        fbApi(Object.assign({ action: "setpublic", public: btn.getAttribute("data-val") === "1" }, base)).then(function (j) { j.ok ? loadList() : msg(j.message || "失败", true); });
      } else if (act === "delete") {
        if (!confirm("确定删除该条反馈？此操作不可恢复。")) return;
        fbApi(Object.assign({ action: "delete" }, base)).then(function (j) { j.ok ? (msg("已删除"), loadList()) : msg(j.message || "失败", true); });
      } else if (act === "edit") {
        var content = item.querySelector(".content").textContent;
        var v = prompt("编辑反馈内容：", content);
        if (v === null || v.trim() === content) return;
        fbApi(Object.assign({ action: "edit", content: v.trim() }, base)).then(function (j) { j.ok ? (msg("已保存"), loadList()) : msg(j.message || "失败", true); });
      }
    });

    $("btn-add").addEventListener("click", function () {
      fbApi({
        action: "add", user: state.user, token: state.token,
        type: $("add-type").value, contact: $("add-contact").value.trim(),
        content: $("add-content").value.trim(), public: $("add-public").checked
      }).then(function (j) {
        if (!j.ok) { msg(j.message || "添加失败", true); return; }
        msg("已添加"); $("add-content").value = ""; $("add-contact").value = ""; $("add-public").checked = false;
        loadList();
      });
    });

    loadCaptcha(); // 登录页图形验证码
    if (state.user && state.token) {
      fbApi({ action: "list", user: state.user, token: state.token }).then(function (j) { j.ok ? enterAdmin() : logout(); }).catch(logout);
    }
  })();
  </script>
