    function bindCountdown(btn, cdSpan, seconds) {
      var left = seconds;
      var timer = null;
      return function start() {
        if (timer) return;
        left = seconds;
        btn.disabled = true;
        cdSpan.textContent = "(" + left + "s 后可重发)";
        timer = setInterval(function () {
          left--;
          if (left <= 0) { clearInterval(timer); timer = null; btn.disabled = false; cdSpan.textContent = ""; }
          else cdSpan.textContent = "(" + left + "s 后可重发)";
        }, 1000);
      };
    }
