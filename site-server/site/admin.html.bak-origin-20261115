      });
      $("rec-pager").addEventListener("click", function (e) {
        var b = e.target.closest("button[data-rpage]");
        if (!b || b.disabled) return;
        var p = parseInt(b.getAttribute("data-rpage"), 10);
        if (p >= 1 && p !== recState.page) { recState.page = p; recLoad(); }
      });
      $("rec-pager").addEventListener("change", function (e) {
        if (e.target.id !== "rec-page-size") return;
        var n = parseInt(e.target.value, 10);
        if ([5, 10, 20, 50, 100].indexOf(n) < 0) n = 10;
        recState.pageSize = n;
        recState.page = 1;
        try { localStorage.setItem("rec_page_size", String(n)); } catch (err) {}
        recLoad();
      });
      $("rec-list").addEventListener("change", function (e) {
        if (e.target.classList && e.target.classList.contains("sel-item")) recUpdateBatch();
      });
      $("rec-sel-all").addEventListener("change", function () {
        var on = $("rec-sel-all").checked;
        document.querySelectorAll("#rec-list .sel-item").forEach(function (c) { c.checked = on; });
        recUpdateBatch();
      });
      $("rec-batch-del").addEventListener("click", function () {
        var ids = recSelectedIds();
        if (!ids.length) return;
        if (!confirm("确定删除选中的 " + ids.length + " 台设备统计记录？此操作不可恢复。")) return;
        var btn = $("rec-batch-del");
        btn.disabled = true; btn.textContent = "删除中…";
        stApi({ action: "delete", user: state.user, token: state.token, anonIds: ids })
          .then(function (j) {
            if (j.ok) { stMsg("已删除 " + (j.deleted || ids.length) + " 台"); }
            else stMsg(j.message || "删除失败", true);
            recLoad();
          }).catch(function () { stMsg("网络错误，请重试", true); recLoad(); });
      });
      /* 记录行内按钮:删除 / 编辑 / 编辑保存 / 编辑取消 */
      $("rec-list").addEventListener("click", function (e) {
        var del = e.target.closest("[data-anon-del]");
        if (del) {
          var id = del.getAttribute("data-anon-del");
          if (!confirm("确定删除该设备的统计记录？")) return;
          stApi({ action: "delete", user: state.user, token: state.token, anonId: id })
            .then(function (j) { j.ok ? (stMsg("已删除"), recLoad()) : stMsg(j.message || "失败", true); });
          return;
        }
        var ed = e.target.closest("[data-anon-edit]");
        if (ed) {
          var item = ed.closest(".fb-item");
