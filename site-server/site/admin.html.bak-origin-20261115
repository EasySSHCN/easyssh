    /* ---------- v5.1.5:最近提交动态(完整分页 + 自动刷新同步 + 全量列表弹窗) ---------- */
    var stLogPage = 1;
    var stLogPageSize = Math.max(1, parseInt(localStorage.getItem("stlog_page_size") || "10", 10) || 10); // 默认每页 10 条
    /* 通用完整分页条:当前显示第几条到第几条 共几条 · 首页/上一页/页码…/下一页/末页 · 每页显示几条(项目级规范) */
    function fullPager(total, page, pageSize, prefix, sizes) {
      sizes = sizes || [10, 20, 50, 100, 200];
      var pages = Math.max(1, Math.ceil(total / pageSize));
      if (page > pages) page = pages;
      var from = total === 0 ? 0 : (page - 1) * pageSize + 1;
      var to = Math.min(total, page * pageSize);
      var btn = function (label, p, dis, cur) {
        return '<button type="button" data-' + prefix + '="' + p + '"' + (dis ? " disabled" : "") +
          (cur ? ' class="pg-cur"' : "") + '>' + label + '</button>';
      };
      var nums = "";
      var dots = false;
      for (var p = 1; p <= pages; p++) {
        if (pages > 9 && p > 2 && p < pages - 1 && Math.abs(p - page) > 1) {
          if (!dots) { nums += "<span class='pg-dots'>…</span>"; dots = true; }
          continue;
        }
        dots = false;
        nums += btn(String(p), p, false, p === page);
      }
      var opts = sizes.map(function (n) {
        return '<option value="' + n + '"' + (n === pageSize ? " selected" : "") + '>' + n + ' 条/页</option>';
      }).join("");
      return '<span class="pg-info">当前显示第 ' + from + ' - ' + to + ' 条 · 共 ' + total + ' 条 · 第 ' + page + ' / ' + pages + ' 页</span>' +
        '<span class="pg-btns">' +
        btn("« 首页", 1, page === 1, false) +
        btn("‹ 上一页", page - 1, page === 1, false) +
        nums +
        btn("下一页 ›", page + 1, page >= pages, false) +
        btn("末页 »", pages, page >= pages, false) +
        '</span>' +
        '<span class="pg-size">每页 <select data-' + prefix + 'size="1" style="padding:4px 8px;font:inherit;font-size:13px;color:var(--text);background:var(--bg-term);border:1px solid var(--border);border-radius:var(--radius-sm);outline:none;cursor:pointer;">' + opts + '</select></span>';
    }
    /* 提交动态行渲染(内嵌列表与弹窗共用):单行铺满列表宽度,超宽自动省略号截断;每个弹窗链接带唯一 data-uid */
    var stLinkUid = 0;
    function stLinkUidNext(p) { return p + '-' + Date.now().toString(36) + '-' + (++stLinkUid); }
    function stLogRowsHtml(rows, offset) {
      return rows.map(function (r, i) {
        var t = new Date(r.t || 0).toLocaleString();
        var id = String(r.anonId || r.id || "");
        var uidTime = stLinkUidNext('stdev'), uidDev = stLinkUidNext('streports'), uidIp = stLinkUidNext('stip'), uidReg = stLinkUidNext('stregion');
        var bits = [];
        if (r.v) bits.push('<span style="color:var(--accent);">v' + esc(r.v) + '</span>');
        if (r.region) {
          var mIP = String(r.region).match(/((?:\d{1,3}\.){2}x\.x)\s*$/);
          if (mIP) {
            var reg = String(r.region).slice(0, mIP.index).replace(/\s+$/, '');
            bits.push('📍' + (reg ? '<a href="javascript:void(0)" class="num-link" data-uid="' + uidReg + '" data-stregion="' + esc(reg) + '" title="点击查看该归属地的所有设备详细记录">' + esc(reg) + '</a> ' : '') +
              '<a href="javascript:void(0)" class="num-link" data-uid="' + uidIp + '" data-stip="' + esc(mIP[1]) + '" title="点击查看该 IP 的所有设备详细记录">' + esc(mIP[1]) + '</a>');
          }
          else bits.push('📍' + esc(r.region));
        }
        if (r.reports) bits.push('<a href="javascript:void(0)" class="num-link" data-uid="' + uidDev + '" data-streports="' + esc(id) + '" title="点击查看该设备上报明细列表">上报' + esc(String(r.reports)) + '次</a>');
        if (r.activityTotal) bits.push('累计活跃 ' + esc(String(r.activityTotal)) + ' 天');
        return '<div class="stlog-row meta" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block;width:100%;">' +
          '<a href="javascript:void(0)" class="num-link" data-uid="' + uidTime + '" data-stdev="' + esc(id) + '" data-sttime="' + esc(String(r.t || 0)) + '" title="点击查看此时间的所有动态记录">🕘 ' + esc(t) + '</a> · ' +
          '设备 ' + esc(id) + ' · ' +
          (bits.length ? ' · ' + bits.join(' · ') : '') + '</div>';
      }).join("");
    }
    function renderStLog(rows, total) {
      var box = $("st-log");
      if (!rows || !rows.length) { box.innerHTML = '<p style="color:#8fa3b8;">暂无提交动态</p>'; $("st-log-pager").innerHTML = ""; return; }
      var from0 = (stLogPage - 1) * stLogPageSize;
      box.innerHTML = '<div class="fb-item">' + stLogRowsHtml(rows, from0) + '</div>';
      $("st-log-pager").innerHTML = fullPager(total, stLogPage, stLogPageSize, "stlog");
    }
    function loadStLog() {
      stApi({ action: "log", user: state.user, token: state.token, page: stLogPage, pageSize: stLogPageSize }).then(function (j) {
        if (j.ok) renderStLog(j.rows || [], j.total || 0);
      }).catch(function () {});
    }
    $("st-log-pager").addEventListener("click", function (e) {
      var b = e.target.closest("button[data-stlog]");
      if (!b || b.disabled) return;
      stLogPage = parseInt(b.getAttribute("data-stlog"), 10) || 1;
      loadStLog();
    });
    $("st-log-pager").addEventListener("change", function (e) {
      if (!e.target.getAttribute("data-stlogsize")) return;
      var n = parseInt(e.target.value, 10);
      if ([10, 20, 50, 100, 200].indexOf(n) < 0) n = 10;
      stLogPageSize = n; stLogPage = 1;
      try { localStorage.setItem("stlog_page_size", String(n)); } catch (err) {}
      loadStLog();
    });

    /* ---------- 自动刷新同步(默认 3 秒,可自定义,0=关闭;localStorage 记忆) ---------- */
    var stLogTimer = null;
    function stLogAutoRefreshSec() {
      var n = parseInt($("stlog-refresh-sec").value, 10);
      if (!isFinite(n) || n < 0) n = 3;
      if (n > 86400) n = 86400;
      return n;
    }
    function stLogTick() {
      if (document.hidden) return;                                    // 页面在后台时不刷
      if ($("admin-box").style.display === "none") return;            // 未登录不刷
      if (!$("tab-stats").classList.contains("on")) return;           // 非统计标签页不刷
      /* 仅局部异步刷新「最近提交动态」内嵌列表(#st-log + #st-log-pager);
         全量弹窗(#stlogModal)打开时不自动刷新,保持用户正在浏览的分页位置不变 */
      loadStLog();
    }
    function stLogApplyRefresh() {
      var sec = stLogAutoRefreshSec();
      try { localStorage.setItem("stlog_refresh_sec", String(sec)); } catch (err) {}
      if (stLogTimer) { clearInterval(stLogTimer); stLogTimer = null; }
