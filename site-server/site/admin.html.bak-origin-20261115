    function recRenderPager() {
      var pages = Math.max(1, Math.ceil(recState.total / recState.pageSize));
      if (recState.page > pages) recState.page = pages;
      var from = recState.total === 0 ? 0 : (recState.page - 1) * recState.pageSize + 1;
      var to = Math.min(recState.total, recState.page * recState.pageSize);
      var btn = function (label, page, dis, cur) {
