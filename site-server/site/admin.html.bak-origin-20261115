    function distCard(title, bucket, unit, fullKey, dispFn) {
      var keys = Object.keys(bucket);
      var max = 0;
      keys.forEach(function (k) { max = Math.max(max, bucket[k]); });
      if (!max) max = 1;
      var rows = keys.map(function (k) {
        var label = dispFn ? dispFn(k) : k;
        return '<div class="bar-row"><span class="bar-label" title="' + esc(label) + '">' + esc(label) + '</span>' +
          '<span class="bar-track"><span class="bar-fill" style="width:' + Math.round(bucket[k] / max * 100) + '%"></span></span>' +
          '<span class="bar-num"><a href="javascript:void(0)" class="num-link" data-dist="' + esc(fullKey) + '" data-value="' + esc(k) +
          '" data-label="' + esc(label) + '" title="点击查看该类设备明细列表">' + bucket[k] + (unit || "台") + '</a></span></div>';
      }).join("");
      var head = fullKey
        ? '<span class="dist-link" data-dist="' + fullKey + '" data-title="' + esc(title) + '" title="点击查看完整列表">' + esc(title) + ' ›</span>'
        : esc(title);
      return '<div class="dist-card"><h3>' + head + '</h3>' + (rows || '<span style="color:#8fa3b8;font-size:12px;">暂无数据</span>') + '</div>';
    }

