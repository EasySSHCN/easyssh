      if (h) {
        h.style.cursor = "pointer";
        h.title = "鐐瑰嚮灞曞紑/鏀惰捣";
        h.addEventListener("click", function () { el.classList.toggle("collapsed"); });
      }
    });

    renderChangelogPager(root, pages, total);
  }

  /** changelog 鍒嗛〉鎺т欢锛氫笂涓€椤?/ 椤电爜 / 涓嬩竴椤?*/
  function renderChangelogPager(root, pages, total) {
    if (pages <= 1) return;
    var nav = document.createElement("nav");
    nav.className = "pager";
    nav.setAttribute("aria-label", "鏇存柊鏃ュ織鍒嗛〉");

    var html = '<button type="button" class="pager-btn"' +
      (changelogPage <= 1 ? " disabled" : "") + ' data-page="' + (changelogPage - 1) + '">' + t("鈥?涓婁竴椤?) + '</button>';

    // 椤电爜杈冨鏃舵姌鍙犳樉绀猴細1 鈥?p-1 p p+1 鈥?鏈〉
    var nums = [];
    for (var i = 1; i <= pages; i++) {
      if (i === 1 || i === pages || Math.abs(i - changelogPage) <= 1) nums.push(i);
      else if (nums[nums.length - 1] !== "鈥?) nums.push("鈥?);
    }
    nums.forEach(function (n) {
      if (n === "鈥?) {
        html += '<span class="pager-ellipsis">鈥?/span>';
      } else {
        html += '<button type="button" class="pager-btn' +
          (n === changelogPage ? " active" : "") + '" data-page="' + n + '"' +
          (n === changelogPage ? ' aria-current="page"' : "") + ">" + n + "</button>";
      }
    });

    html += '<button type="button" class="pager-btn"' +
      (changelogPage >= pages ? " disabled" : "") + ' data-page="' + (changelogPage + 1) + '">' + t("涓嬩竴椤?鈥?) + '</button>';

    html += '<span class="pager-info">' + t("鍏?") + total + t(" 涓増鏈?路 绗?") + changelogPage + t(" / ") + pages + t(" 椤?) + '</span>';
    nav.innerHTML = html;
    root.appendChild(nav);

    nav.addEventListener("click", function (e) {
      var btn = e.target.closest("[data-page]");
      if (!btn || btn.disabled) return;
      var p = parseInt(btn.getAttribute("data-page"), 10);
