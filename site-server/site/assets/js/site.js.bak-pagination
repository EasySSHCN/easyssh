/* =========================================================
   EasySSH 官网前端渲染脚本
   唯一数据源：data/site-data.json（由 tools/sync.js 生成，勿手改）
   零依赖，兼容子路径部署（相对路径 fetch）。
   ========================================================= */
(function () {
  "use strict";

  /* ---------- 辅助函数 ---------- */

  /** 字节数人性化：74931334 -> "71.5 MB" */
  function formatBytes(bytes) {
    if (typeof bytes !== "number" || isNaN(bytes) || bytes < 0) return "—";
    if (bytes === 0) return "0 B";
    var units = ["B", "KB", "MB", "GB", "TB"];
    var i = Math.floor(Math.log(bytes) / Math.log(1024));
    var v = bytes / Math.pow(1024, i);
    return (i === 0 ? v : v.toFixed(1)) + " " + units[i];
  }

  /** 日期格式化：ISO 字符串 -> "YYYY-MM-DD"（无效返回原文或 —） */
  function formatDate(iso) {
    if (!iso) return "—";
    var d = new Date(iso);
    if (isNaN(d.getTime())) return String(iso);
    var p = function (n) { return n < 10 ? "0" + n : "" + n; };
    return d.getFullYear() + "-" + p(d.getMonth() + 1) + "-" + p(d.getDate());
  }

  /** 复制文本到剪贴板（带降级方案），成功回调可选 */
  function copyText(text, onDone) {
    function ok() { if (onDone) onDone(true); }
    function fail() { if (onDone) onDone(false); }
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(ok, function () { legacy(); });
    } else { legacy(); }
    function legacy() {
      try {
        var ta = document.createElement("textarea");
        ta.value = text;
        ta.style.position = "fixed"; ta.style.opacity = "0";
        document.body.appendChild(ta);
        ta.select();
        var r = document.execCommand("copy");
        document.body.removeChild(ta);
        r ? ok() : fail();
      } catch (e) { fail(); }
    }
  }

  /** 按点号路径取对象值：get(obj, "latest.exe.url") */
  function get(obj, path) {
    return path.split(".").reduce(function (o, k) {
      return o == null ? undefined : o[k];
    }, obj);
  }

  /** 显示 file:// 等场景的降级提示 */
  function showFallback() {
    document.querySelectorAll("[data-fallback]").forEach(function (el) {
      el.classList.add("show");
    });
  }

  /* ---------- 渲染 ---------- */

  function renderSlots(data) {
    document.querySelectorAll("[data-slot]").forEach(function (el) {
      var path = el.getAttribute("data-slot");
      var val = get(data, path);
      if (val === undefined) return;
      // 属性模式：data-slot-attr="href|title|src"
      var attr = el.getAttribute("data-slot-attr");
      if (attr) {
        // 首页「立即下载」按钮固定跳转 download.html（v4.3.0 需求），不被 latest.exe.url 覆盖
        if (path === "latest.exe.url" && attr === "href" && el.getAttribute("href") === "download.html") return;
        el.setAttribute(attr, String(val));
      } else {
        // 特殊渲染：以 data-slot-format 指定格式化方式
        var fmt = el.getAttribute("data-slot-format");
        if (fmt === "bytes") el.textContent = formatBytes(val);
        else if (fmt === "date") el.textContent = formatDate(val);
        else el.textContent = String(val);
      }
    });
  }

  /** 首页：特性亮点卡（来自 project.features） */
  function renderFeatures(data) {
    var box = document.getElementById("features-grid");
    if (!box || !data.project || !Array.isArray(data.project.features)) return;
    // 图示符号与标题（标题取自 features 文本，符号固定循环使用）
    var icons = ["⌨", "🔄", "📁", "⚡", "⚙", "🖥", "🔒", "📋"];
    box.innerHTML = data.project.features.map(function (f, i) {
      var clean = f.replace(/\*\*/g, "");
      return '<div class="card"><h3>' + (icons[i % icons.length]) + " " +
        escapeHtml(clean) + "</h3></div>";
    }).join("");
  }

  /** features 页：功能列表 + 使用说明 */
  function renderFeaturesPage(data) {
    var fl = document.getElementById("features-list");
    if (fl && data.project && Array.isArray(data.project.features)) {
      fl.innerHTML = data.project.features.map(function (f) {
        return "<li>" + inlineMd(f) + "</li>";
      }).join("");
    }
    var us = document.getElementById("usage-list");
    if (us && data.project && Array.isArray(data.project.usage)) {
      us.innerHTML = data.project.usage.map(function (u) {
        return "<li>" + inlineMd(u) + "</li>";
      }).join("");
    }
    var tag = document.getElementById("project-tagline");
    if (tag && data.project && data.project.tagline) tag.textContent = data.project.tagline;
  }

  /** 下载页：最新版双卡片 + 历史版本表 */
  function renderDownload(data) {
    // 顶部卡片：绿色单文件 / 安装引导 exe / 便携 zip / 源码
    ["portable", "exe", "zip", "source"].forEach(function (kind) {
      var box = document.getElementById("dl-card-" + kind);
      var item = get(data, "latest." + kind);
      if (!box || !item || !item.file) return;
      box.innerHTML =
        '<div class="dl-icon">' + (kind === "portable" ? "🟢" : (kind === "exe" ? "📦" : (kind === "zip" ? "🗜" : "📄"))) + "</div>" +
        "<h3>" + (kind === "portable" ? "绿色单文件（免安装）" : (kind === "exe" ? "安装版" : (kind === "zip" ? "绿色便携包" : "开源源代码"))) + "</h3>" +
        '<div class="dl-file">' + escapeHtml(item.file) + "</div>" +
        '<div class="dl-meta">版本 <span class="mono">' + escapeHtml(data.latestVersion) +
        "</span> · " + formatBytes(item.size) + " · 更新于 " + formatDate(item.mtime) + "</div>" +
        '<a class="btn btn-primary" href="' + escapeHtml(item.url) + '">⬇ 下载</a>' +
        '<div class="sha-box"><span>SHA256: ' + escapeHtml(item.sha256 || "—") + "</span>" +
        '<button class="copy-btn" type="button" data-copy="' + escapeHtml(item.sha256 || "") + '">复制</button></div>';
    });
    // 历史版本表
    var tb = document.getElementById("releases-body");
    if (tb && Array.isArray(data.releases)) {
      tb.innerHTML = data.releases.map(function (r) {
        return "<tr>" +
          '<td class="mono">v' + escapeHtml(r.version) + "</td>" +
          "<td>" + escapeHtml(r.date || "—") + "</td>" +
          '<td class="mono">' +
          (r.portable ? '<a href="' + escapeHtml(r.portable.url) + '" title="绿色单文件,免安装免解压直接运行">单文件</a>' : "—") + " · " +
          (r.exe ? '<a href="' + escapeHtml(r.exe.url) + '">exe</a>' : "—") + " · " +
          (r.zip ? '<a href="' + escapeHtml(r.zip.url) + '">zip</a>' : "—") + " · " +
          (r.source ? '<a href="' + escapeHtml(r.source.url) + '" title="该版本开源源代码 (MIT)">源码</a>' : "—") +
          "</td>" +
          '<td class="mono">' + (r.portable ? formatBytes(r.portable.size) : "—") + "</td>" +
          '<td class="mono">' + (r.exe ? formatBytes(r.exe.size) : "—") + "</td>" +
          '<td class="mono">' + (r.zip ? formatBytes(r.zip.size) : "—") + "</td>" +
          '<td class="mono">' + (r.source ? formatBytes(r.source.size) : "—") + "</td>" +
          "</tr>";
      }).join("");
    }
  }

  /** changelog 页：完整更新日志时间线（分页显示） */
  var CHANGELOG_PAGE_SIZE = 10; // 每页显示的版本条目数
  var changelogPage = 1;

  function renderChangelog(data) {
    var root = document.getElementById("changelog-root");
    if (!root || !Array.isArray(data.changelog)) return;

    var total = data.changelog.length;
    var pages = Math.max(1, Math.ceil(total / CHANGELOG_PAGE_SIZE));
    if (changelogPage > pages) changelogPage = pages;
    if (changelogPage < 1) changelogPage = 1;

    var start = (changelogPage - 1) * CHANGELOG_PAGE_SIZE;
    var slice = data.changelog.slice(start, start + CHANGELOG_PAGE_SIZE);

    root.innerHTML = slice.map(function (c) {
      return '<div class="changelog-item">' +
        "<h3>v" + escapeHtml(c.version) +
        '<span class="date">' + escapeHtml(c.date || "") + "</span></h3>" +
        "<ul>" + (c.notes || []).map(function (n) {
          return "<li>" + inlineMd(n) + "</li>";
        }).join("") + "</ul></div>";
    }).join("");

    renderChangelogPager(root, pages, total);
  }

  /** changelog 分页控件：上一页 / 页码 / 下一页 */
  function renderChangelogPager(root, pages, total) {
    if (pages <= 1) return;
    var nav = document.createElement("nav");
    nav.className = "pager";
    nav.setAttribute("aria-label", "更新日志分页");

    var html = '<button type="button" class="pager-btn"' +
      (changelogPage <= 1 ? " disabled" : "") + ' data-page="' + (changelogPage - 1) + '">‹ 上一页</button>';

    // 页码较多时折叠显示：1 … p-1 p p+1 … 末页
    var nums = [];
    for (var i = 1; i <= pages; i++) {
      if (i === 1 || i === pages || Math.abs(i - changelogPage) <= 1) nums.push(i);
      else if (nums[nums.length - 1] !== "…") nums.push("…");
    }
    nums.forEach(function (n) {
      if (n === "…") {
        html += '<span class="pager-ellipsis">…</span>';
      } else {
        html += '<button type="button" class="pager-btn' +
          (n === changelogPage ? " active" : "") + '" data-page="' + n + '"' +
          (n === changelogPage ? ' aria-current="page"' : "") + ">" + n + "</button>";
      }
    });

    html += '<button type="button" class="pager-btn"' +
      (changelogPage >= pages ? " disabled" : "") + ' data-page="' + (changelogPage + 1) + '">下一页 ›</button>';

    html += '<span class="pager-info">共 ' + total + ' 个版本 · 第 ' + changelogPage + " / " + pages + " 页</span>";
    nav.innerHTML = html;
    root.appendChild(nav);

    nav.addEventListener("click", function (e) {
      var btn = e.target.closest("[data-page]");
      if (!btn || btn.disabled) return;
      var p = parseInt(btn.getAttribute("data-page"), 10);
      if (!p || p === changelogPage) return;
      changelogPage = p;
      renderChangelog(latestData);
      // 翻页后回到日志区顶部，保持阅读位置
      root.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  }

  /** 极简 markdown 行内转换：**加粗** 与 `代码` */
  function inlineMd(s) {
    return escapeHtml(String(s))
      .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
      .replace(/`([^`]+)`/g, "<code>$1</code>");
  }

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
      return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
    });
  }

  /* ---------- 事件绑定（复制按钮、移动端导航） ---------- */

  document.addEventListener("click", function (e) {
    var btn = e.target.closest("[data-copy]");
    if (btn) {
      copyText(btn.getAttribute("data-copy"), function () {
        var old = btn.textContent;
        btn.textContent = "已复制 ✓";
        setTimeout(function () { btn.textContent = old; }, 1500);
      });
    }
    var toggle = document.getElementById("nav-toggle");
    var links = document.getElementById("nav-links");
    if (toggle && links && (e.target === toggle || toggle.contains(e.target))) {
      links.classList.toggle("open");
    }
  });

  /** 下载页：开源源代码卡片（latest.source） */
  function renderSource(data) {
    var box = document.getElementById("dl-card-source");
    if (!box) return;
    var s = data && data.latest && data.latest.source;
    if (!s || !s.url) {
      box.innerHTML =
        '<div class="dl-icon">🧩</div><h3>开源源代码</h3>' +
        '<div class="dl-meta">源码包生成暂不可用，可通过仓库获取（见参与贡献页）。</div>';
      return;
    }
    box.innerHTML =
      '<div class="dl-icon">🧩</div><h3>开源源代码（MIT）</h3>' +
      '<div class="dl-file">' + escapeHtml(s.file) + "</div>" +
      '<div class="dl-meta">v<span class="mono">' + escapeHtml(data.latestVersion) + "</span> · " +
      formatBytes(s.size) + " · 含全部源代码，不含依赖与构建产物</div>" +
      '<a class="btn btn-primary" href="' + escapeHtml(s.url) + '">⬇ 下载源代码</a>' +
      '<div class="sha-box"><span>SHA256: ' + escapeHtml(s.sha256 || "—") + "</span>" +
      '<button class="copy-btn" type="button" data-copy="' + escapeHtml(s.sha256 || "") + '">复制</button></div>';
  }

  /* ---------- GitHub/Gitee 弹窗链接 ---------- */
  document.addEventListener("click", function (e) {
    var a = e.target.closest("a[data-popup]");
    if (!a) return;
    e.preventDefault();
    window.open(a.href, "easyssh_popup", [
      "width=1100", "height=800", "left=" + Math.max(0, (screen.width - 1100) / 2 | 0),
      "top=" + Math.max(0, (screen.height - 800) / 2 | 0),
      "menubar=no", "toolbar=no", "resizable=yes", "scrollbars=yes", "status=yes"
    ].join(","));
  });

  /** 下载页：使用反馈精选 TOP10（已回复且公开） */
  function truncateText(s, n) {
    s = String(s || "");
    return s.length > n ? s.slice(0, n) + "…" : s;
  }

  function renderFeedbackTop() {
    var box = document.getElementById("feedback-top");
    if (!box) return;
    fetch("api/feedback/top.php")
      .then(function (r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
      .then(function (j) {
        var items = (j && j.ok && Array.isArray(j.items)) ? j.items : [];
        if (!items.length) {
          box.innerHTML = '<p style="color:var(--c-text-dim);margin:0;">暂无已公开的反馈回复。欢迎在 EasySSH 软件内点击「💬 反馈」提交您的建议与问题。</p>';
          return;
        }
        box.innerHTML = items.map(function (it, i) {
          return '<div class="notice" style="margin:0;">' +
            "<strong>" + (i + 1) + ". [" + escapeHtml(it.type || "反馈") + "] " +
            escapeHtml(truncateText(it.content, 120)) + "</strong>" +
            '<div style="color:var(--c-text-dim);font-size:13px;margin-top:4px;">' +
            escapeHtml(it.date || "") + "</div>" +
            '<div style="margin-top:8px;"><strong>官方回复：</strong>' + inlineMd(it.reply || "") + "</div>" +
            "</div>";
        }).join("");
      })
      .catch(function () {
        box.innerHTML = '<p style="color:var(--c-text-dim);margin:0;">反馈列表暂时无法加载，请稍后再试。</p>';
      });
  }

  /** security 页：支持的版本表（与下载页「历史版本」同源 data/site-data.json 自动同步） */
  function renderSecurity(data) {
    var tb = document.getElementById("security-versions-body");
    if (!tb || !Array.isArray(data.releases) || !data.releases.length) return;

    // 按主次版本号（major.minor）聚合，倒序排列；最新 minor 为当前支持版本
    var minors = {};
    data.releases.forEach(function (r) {
      var m = /^v?(\d+\.\d+)\./.exec(r.version || "");
      if (!m) return;
      var key = m[1];
      if (!minors[key] || compareVersions(r.version, minors[key].version) > 0) {
        minors[key] = r;
      }
    });
    var keys = Object.keys(minors).sort(compareVersions).reverse();
    tb.innerHTML = keys.map(function (key, i) {
      var r = minors[key];
      var current = i === 0;
      return "<tr>" +
        '<td class="mono">v' + escapeHtml(key) + ".x</td>" +
        "<td>" + escapeHtml(r.date || "—") + "</td>" +
        "<td>" + (current ? "✅ 当前版本" : "❌ 已停止") + "</td>" +
        "<td>" + (current ? "获得" : "不再提供") + "</td>" +
        "</tr>";
    }).join("") +
      '<tr><td class="mono">&lt; v' + escapeHtml(keys[keys.length - 1]) + '</td><td>—</td><td>❌ 已停止</td><td>不再提供</td></tr>';

    // 底部提示中的版本号随数据自动更新
    var note = document.getElementById("security-version-note");
    if (note) {
      note.innerHTML = "当前最新版本为 <strong>v" + escapeHtml(data.latestVersion || "") +
        "</strong>（" + escapeHtml((data.releases[0] && data.releases[0].date) || "") +
        "），请始终使用最新版本，可在软件内「设置 → 检查更新」在线升级，或前往" +
        '<a href="download.html">下载页</a>获取。旧版本存在已知问题（例如 2.3.0/2.3.1 生成的 PKCS#8 私钥无法被 ssh2 解析，已在 2.3.2 修复并兼容自动转换）。';
    }
  }

  /** 版本号比较：返回 >0 / 0 / <0（兼容 "2.8.5" / "v2.8.5"） */
  function compareVersions(a, b) {
    var pa = String(a).replace(/^v/, "").split(".").map(Number);
    var pb = String(b).replace(/^v/, "").split(".").map(Number);
    for (var i = 0; i < 3; i++) {
      var d = ((pa[i] || 0) - (pb[i] || 0));
      if (d) return d;
    }
    return 0;
  }

  /* ---------- 启动 ---------- */

  var latestData = null; // 缓存最近一次加载的数据，供分页翻页重渲染

  document.addEventListener("DOMContentLoaded", function () {
    fetch("data/site-data.json")
      .then(function (r) {
        if (!r.ok) throw new Error("HTTP " + r.status);
        return r.json();
      })
      .then(function (data) {
        latestData = data;
        renderSlots(data);
        renderFeatures(data);
        renderFeaturesPage(data);
        renderDownload(data);
        renderSource(data);
        renderChangelog(data);
        renderSecurity(data);
      })
      .catch(function () {
        // file:// 打开或数据缺失时优雅降级
        showFallback();
      });
    renderFeedbackTop();
  });
})();
