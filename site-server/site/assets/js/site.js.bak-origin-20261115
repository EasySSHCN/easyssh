  /* ---------- GitHub/Gitee 弹窗链接 ---------- */
  document.addEventListener("click", function (e) {
    var a = e.target.closest("a[data-popup]");
    if (!a) return;
    e.preventDefault();
    window.open(a.href, "easyssh_popup", [
      "width=1100", "height=800", "left=" + Math.max(0, (screen.width - 1100) / 2 | 0),
      "top=" + Math.max(0, (screen.height - 800) / 2 | 0),
      "menubar=no", "toolbar=no", "resizable=yes", "scrollbars=yes", "status=yes"
    ].join(","));
  });

  /** 下载页：使用反馈精选 TOP10（已回复且公开） */
  function truncateText(s, n) {
    s = String(s || "");
    return s.length > n ? s.slice(0, n) + "…" : s;
  }

  function renderFeedbackTop() {
    var box = document.getElementById("feedback-top");
    if (!box) return;
    fetch(siteRoot + "api/feedback/top.php")
      .then(function (r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
      .then(function (j) {
        var items = (j && j.ok && Array.isArray(j.items)) ? j.items : [];
        if (!items.length) {
          box.innerHTML = '<p style="color:var(--c-text-dim);margin:0;">' + t("暂无已公开的反馈回复。欢迎在 EasySSH 软件内点击「💬 反馈」提交您的建议与问题。") + '</p>';
          return;
        }
        /* 分页:每页条数可自定义输入,默认 5 条 */
        var fbPage = 1, fbSize = 5;
        function fbItemHtml(it, idx) {
          return '<div class="notice" style="margin:0;">' +
            "<strong>" + (idx + 1) + ". [" + escapeHtml(it.type || t("反馈")) + "] " +
            escapeHtml(truncateText(it.content, 120)) + "</strong>" +
            '<div style="color:var(--c-text-dim);font-size:13px;margin-top:4px;">' +
            escapeHtml(it.date || "") + "</div>" +
            '<div style="margin-top:8px;"><strong>' + t("官方回复：") + '</strong>' + inlineMd(it.reply || "") + "</div>" +
            "</div>";
        }
        function fbRender() {
          var total = items.length;
          var pages = Math.max(1, Math.ceil(total / fbSize));
          if (fbPage > pages) fbPage = pages;
          if (fbPage < 1) fbPage = 1;
          var start = (fbPage - 1) * fbSize;
          var slice = items.slice(start, start + fbSize);
          var html = slice.map(function (it, i) { return fbItemHtml(it, start + i); }).join("");
          html += '<div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:14px;color:var(--c-text-dim);font-size:13px;">' +
            "<span>" + t("共 ") + total + t("条记录") + "</span>" +
            '<label style="display:inline-flex;align-items:center;gap:6px;">' + t("每页显示") +
            '<input type="number" id="fbPageSize" min="1" max="100" value="' + fbSize + '" style="width:64px;background:var(--c-bg,#111827);color:var(--c-text,#e5e7eb);border:1px solid var(--c-border,#374151);border-radius:6px;padding:2px 6px;"></label>' +
            '<button type="button" class="pager-btn" id="fbPrev" ' + (fbPage <= 1 ? "disabled" : "") + '>' + t("‹ 上一页") + '</button>' +
            "<span>" + t("第 " + fbPage + " / " + pages + " 页") + "</span>" +
            '<button type="button" class="pager-btn" id="fbNext" ' + (fbPage >= pages ? "disabled" : "") + '>' + t("下一页 ›") + '</button>' +
            "</div>";
          box.innerHTML = html;
          var sizeInput = document.getElementById("fbPageSize");
          sizeInput.addEventListener("change", function () {
            var v = parseInt(sizeInput.value, 10);
            if (isNaN(v) || v < 1) v = 1;
            if (v > 100) v = 100;
            sizeInput.value = v;
            fbSize = v;
            fbPage = 1;
            fbRender();
          });
          document.getElementById("fbPrev").addEventListener("click", function () {
            if (fbPage > 1) { fbPage--; fbRender(); }
          });
          document.getElementById("fbNext").addEventListener("click", function () {
            if (fbPage < Math.ceil(items.length / fbSize)) { fbPage++; fbRender(); }
          });
        }
        fbRender();
      })
      .catch(function () {
        box.innerHTML = '<p style="color:var(--c-text-dim);margin:0;">' + t("反馈列表暂时无法加载，请稍后再试。") + '</p>';
      });
  }

  /** security 页：支持的版本表（与下载页「历史版本」同源 data/site-data.json 自动同步） */
  function renderSecurity(data) {
    var tb = document.getElementById("security-versions-body");
    if (!tb || !Array.isArray(data.releases) || !data.releases.length) return;

    // 按主次版本号（major.minor）聚合，倒序排列；最新 minor 为当前支持版本
    var minors = {};
    data.releases.forEach(function (r) {
      var m = /^v?(\d+\.\d+)\./.exec(r.version || "");
      if (!m) return;
      var key = m[1];
      if (!minors[key] || compareVersions(r.version, minors[key].version) > 0) {
        minors[key] = r;
      }
    });
    var keys = Object.keys(minors).sort(compareVersions).reverse();
    tb.innerHTML = keys.map(function (key, i) {
      var r = minors[key];
      var current = i === 0;
      return "<tr>" +
        '<td class="mono">v' + escapeHtml(key) + ".x</td>" +
        "<td>" + escapeHtml(r.date || "—") + "</td>" +
        "<td>" + (current ? t("✅ 当前版本") : t("❌ 已停止")) + "</td>" +
        "<td>" + (current ? t("获得") : t("不再提供")) + "</td>" +
        "</tr>";
    }).join("") +
      '<tr><td class="mono">&lt; v' + escapeHtml(keys[keys.length - 1]) + '</td><td>—</td><td>' + t("❌ 已停止") + '</td><td>' + t("不再提供") + '</td></tr>';

    // 底部提示中的版本号随数据自动更新
    var note = document.getElementById("security-version-note");
    if (note) {
      note.innerHTML = t("当前最新版本为 ") + "<strong>v" + escapeHtml(data.latestVersion || "") +
        "</strong>" + t("（") + escapeHtml((data.releases[0] && data.releases[0].date) || "") +
        t("），请始终使用最新版本，可在软件内「设置 → 检查更新」在线升级，或前往") +
        '<a href="download.html">' + t("下载页") + '</a>' + t("获取。旧版本存在已知问题（例如 2.3.0/2.3.1 生成的 PKCS#8 私钥无法被 ssh2 解析，已在 2.3.2 修复并兼容自动转换）。");
    }
  }

  /** 版本号比较：返回 >0 / 0 / <0（兼容 "2.8.5" / "v2.8.5"） */
  function compareVersions(a, b) {
    var pa = String(a).replace(/^v/, "").split(".").map(Number);
    var pb = String(b).replace(/^v/, "").split(".").map(Number);
    for (var i = 0; i < 3; i++) {
      var d = ((pa[i] || 0) - (pb[i] || 0));
      if (d) return d;
    }
    return 0;
  }

  /* ---------- 站点根定位（兼容 /en/ 子目录部署：以 site.js 自身 URL 为基准） ---------- */
  var siteBase = (function () {
    var s = document.querySelector('script[src*="site.js"]');
    if (!s) return "";
    var src = s.getAttribute("src");
    var i = src.lastIndexOf("/");
    return i >= 0 ? src.slice(0, i + 1) : "";
  })(); // 形如 "/assets/js/"（相对或绝对路径）

  var siteRoot = siteBase + "../../"; // 站点根（site.js 恒位于 assets/js/ 下）

  /* ---------- 启动 ---------- */

  var latestData = null; // 缓存最近一次加载的数据，供分页翻页重渲染

  /* 英文版动态数据：优先加载英文数据文件,失败则回退中文内容 */
  function loadEnOverrides(done) {
    if (!EN) return done();
    var jobs = 2, changelogEn = null, projectEn = null;
    function fin() {
      if (--jobs > 0) return;
      done({ changelog: changelogEn, project: projectEn });
    }
    fetch(siteRoot + "assets/data/site-data.en.json").then(function (r) { return r.ok ? r.json() : null; }).then(function (j) { changelogEn = j; fin(); }).catch(function () { fin(); });
    fetch(siteRoot + "assets/data/en-project.en.json").then(function (r) { return r.ok ? r.json() : null; }).then(function (j) { projectEn = j; fin(); }).catch(function () { fin(); });
  }

  document.addEventListener("DOMContentLoaded", function () {
    fetch(siteRoot + "data/site-data.json")
      .then(function (r) {
        if (!r.ok) throw new Error("HTTP " + r.status);
        return r.json();
      })
      .then(function (data) {
        loadEnOverrides(function (ov) {
          if (ov && ov.changelog && Array.isArray(ov.changelog)) data.changelog = ov.changelog;
          if (ov && ov.project) {
            data.project = data.project || {};
            ["tagline", "features", "usage"].forEach(function (k) {
              if (ov.project[k] !== undefined) data.project[k] = ov.project[k];
            });
          }
          latestData = data;
          renderSlots(data);
          renderFeatures(data);
          renderFeaturesPage(data);
          renderDownload(data);
          renderSource(data);
          renderChangelog(data);
          renderSecurity(data);
        });
      })
      .catch(function () {
        // file:// 打开或数据缺失时优雅降级
        showFallback();
      });
    renderFeedbackTop();
  });
})();
