<?php
/**
 * POST /api/visit/admin.php —— 官网访客统计后台接口（复用反馈管理员令牌鉴权，v5.1.3）
 * 动作：
 *   { action:"summary", user, token } → { ok, summary:{ todayPv, todayUv, ydayPv, ydayUv, totalPv, totalUv,
 *       trend:[{date,pv,uv}...30天], topPages:{}, topRefs:{}, topIps:{} } }
 *   { action:"recent",  user, token, page?, pageSize? } → { ok, rows:[{t,ip,uv,ua,p,r}...], total }
 *   { action:"purge",   user, token } → { ok } 清空访客统计库（保留结构）
 * 鉴权：复用 api/feedback 的 admin_user + 当日 HMAC token。
 */
require __DIR__ . '/common.php';

if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') vst_fail('仅支持 POST', 405);
$in = json_decode(file_get_contents('php://input'), true);
if (!is_array($in)) vst_fail('请求体必须是 JSON');
$action = (string)($in['action'] ?? '');
if (!fb_check_token((string)($in['user'] ?? ''), (string)($in['token'] ?? ''))) {
  vst_fail('未登录或登录已过期，请重新登录', 401);
}

$db = vst_db_load();

switch ($action) {
  case 'summary': {
    $today = date('Y-m-d');
    // 本周:自然周(周一起)至今
    $weekStart = date('Y-m-d', strtotime('monday this week'));
    $totalPv = 0; $totalUvKeys = []; $totalIps = [];
    $topPages = []; $topRefs = []; $topIps = []; $topUas = [];
    foreach ($db['days'] as $d => $day) {
      $totalPv += (int)($day['pv'] ?? 0);
      if (isset($day['uvs']) && is_array($day['uvs'])) {
        foreach ($day['uvs'] as $k => $v) $totalUvKeys[$d . '|' . $k] = true; // UV 按日隔离,跨日去重按日拼接
      }
      foreach ($day['pages'] ?? [] as $k => $v) $topPages[$k] = ($topPages[$k] ?? 0) + $v;
      foreach ($day['refs'] ?? [] as $k => $v) $topRefs[$k] = ($topRefs[$k] ?? 0) + $v;
      // IP 分布基于完整 IP 明细聚合(与「累计 IP 数」同口径;完整 IP 自 2026-11-13 晚上线时起记录)
      foreach ($day['ipsFull'] ?? [] as $k => $v) {
        $totalIps[$k] = true;
        $topIps[$k] = ($topIps[$k] ?? 0) + (int)(is_array($v) ? ($v['c'] ?? 1) : 1);
      }
    }
    arsort($topPages); arsort($topRefs); arsort($topIps);
    // 浏览器家族分布:统一从最近访客流水聚合(与「最近访客」列表所见一致;按日 uas 桶仅作归档留存)
    foreach ($db['recent'] as $r) {
      $u = (string)($r['ua'] ?? '');
      if ($u !== '') $topUas[$u] = ($topUas[$u] ?? 0) + 1;
    }
    arsort($topUas);
    // TOP10 IP 转明细数组并附归属地(复用统计模块查询链,前缀级缓存)
    $topIpsRows = [];
    $i = 0;
    foreach ($topIps as $k => $v) {
      if ($i++ >= 10) break;
      $topIpsRows[] = ['ip' => $k, 'c' => $v, 'region' => vst_region($k)];
    }
    // 近 30 天趋势 + 本周聚合
    $nowMs = vst_now_ms();
    $trend = [];
    $weekPv = 0; $weekUv = 0; $weekIps = [];
    for ($i = 29; $i >= 0; $i--) {
      $d = date('Y-m-d', (int)(($nowMs - $i * 24 * 3600 * 1000) / 1000));
      $day = $db['days'][$d] ?? [];
      $pv = (int)($day['pv'] ?? 0); $uv = (int)($day['uv'] ?? 0);
      $trend[] = ['date' => $d, 'pv' => $pv, 'uv' => $uv, 'ips' => count($day['ipsFull'] ?? [])];
      if ($d >= $weekStart) {
        $weekPv += $pv; $weekUv += $uv;
        foreach ($day['ipsFull'] ?? [] as $k => $v) $weekIps[$k] = true;
      }
    }
    $td = $db['days'][$today] ?? [];
    vst_json_out(['ok' => true, 'summary' => [
      'todayPv' => (int)($td['pv'] ?? 0), 'todayUv' => (int)($td['uv'] ?? 0),
      'todayIps' => count($td['ipsFull'] ?? []),
      'weekPv' => $weekPv, 'weekUv' => $weekUv, 'weekIps' => count($weekIps),
      'totalPv' => $totalPv, 'totalUv' => count($totalUvKeys), 'totalIps' => count($totalIps),
      'trend' => $trend,
      'topPages' => array_slice($topPages, 0, 10, true),
      'topRefs' => array_slice($topRefs, 0, 10, true),
      'topUas' => array_slice($topUas, 0, 10, true),
      'topIps' => $topIpsRows,
    ]]);
  }

  case 'detail': {
    // v5.1.4:卡片/TOP10 明细弹窗统一接口
    // type: visits(访客流水,来自最近1000条) | uv(UV哈希聚合) | ip(完整IP明细,IPv4/IPv6)
    // scope: today | week | total；filter: {p,r,ip} 仅 visits 支持(与 TOP10 联动)
    $type = (string)($in['type'] ?? '');
    $scope = (string)($in['scope'] ?? 'today');
    if (!in_array($type, ['visits', 'uv', 'ip', 'pages', 'refs', 'uas'], true)) vst_fail('类型非法');
    if (!in_array($scope, ['today', 'week', 'total'], true)) vst_fail('范围非法');
    $page = max(1, (int)($in['page'] ?? 1));
    $pageSize = min(100, max(1, (int)($in['pageSize'] ?? 10)));
    $fp = isset($in['filter']['p']) ? (string)$in['filter']['p'] : '';
    $fr = isset($in['filter']['r']) ? (string)$in['filter']['r'] : '';
    $fip = isset($in['filter']['ip']) ? (string)$in['filter']['ip'] : '';
    $fua = isset($in['filter']['ua']) ? (string)$in['filter']['ua'] : '';
    $weekStart = date('Y-m-d', strtotime('monday this week'));
    $today = date('Y-m-d');
    $inScope = function ($d) use ($scope, $today, $weekStart) {
      return $scope === 'today' ? ($d === $today) : ($scope === 'week' ? ($d >= $weekStart) : true);
    };

    if ($type === 'pages' || $type === 'refs') {
      // 标题链接:全站聚合的完整排序明细(近180天保留期内,按次数倒序,标准分页)
      $agg = [];
      foreach ($db['days'] as $d => $day) {
        foreach (($type === 'pages' ? ($day['pages'] ?? []) : ($day['refs'] ?? [])) as $k => $v) {
          $agg[$k] = ($agg[$k] ?? 0) + $v;
        }
      }
      arsort($agg);
      $rows = [];
      foreach ($agg as $k => $v) $rows[] = ['name' => $k, 'c' => $v];
      $total = count($rows);
      $rows = array_slice($rows, ($page - 1) * $pageSize, $pageSize);
      vst_json_out(['ok' => true, 'rows' => $rows, 'total' => $total, 'kind' => $type]);
    }

    if ($type === 'uas') {
      // 浏览器家族全量排序明细:统一从最近访客流水聚合(与卡片口径一致)
      $agg = [];
      foreach ($db['recent'] as $r) {
        $u = (string)($r['ua'] ?? '');
        if ($u !== '') $agg[$u] = ($agg[$u] ?? 0) + 1;
      }
      arsort($agg);
      $rows = [];
      foreach ($agg as $k => $v) $rows[] = ['name' => $k, 'c' => $v];
      $total = count($rows);
      $rows = array_slice($rows, ($page - 1) * $pageSize, $pageSize);
      vst_json_out(['ok' => true, 'rows' => $rows, 'total' => $total, 'kind' => 'uas']);
    }

    if ($type === 'visits') {
      // 访客流水:最近 1000 条内按时间范围与可选过滤条件筛选,最新在前
      $tMin = $scope === 'today' ? strtotime($today . ' 00:00') * 1000
        : ($scope === 'week' ? strtotime($weekStart . ' 00:00') * 1000 : 0);
      $rows = [];
      foreach ($db['recent'] as $r) {
        if ((int)($r['t'] ?? 0) < $tMin) continue;
        if ($fp !== '' && ($r['p'] ?? '') !== $fp) continue;
        if ($fr !== '' && ($r['r'] ?? '') !== $fr) continue;
        if ($fip !== '' && ($r['f'] ?? '') !== $fip && ($r['ip'] ?? '') !== $fip) continue;
        if ($fua !== '' && ($r['ua'] ?? '') !== $fua) continue;
        $rows[] = $r;
      }
      $total = count($rows);
      $rows = array_slice($rows, ($page - 1) * $pageSize, $pageSize);
      // 归属地只查当页行,前缀级缓存命中后开销极低
      foreach ($rows as &$r) $r['region'] = vst_region((string)($r['f'] ?? $r['ip'] ?? ''));
      unset($r);
      vst_json_out(['ok' => true, 'rows' => $rows, 'total' => $total, 'kind' => 'visits']);
    }

    if ($type === 'uv') {
      // UV 聚合:{哈希: {c:出现天数内次数, last:最后日期}}(哈希按日轮换,仅统计用途)
      $agg = [];
      foreach ($db['days'] as $d => $day) {
        if (!$inScope($d)) continue;
        foreach ($day['uvs'] ?? [] as $h => $v) {
          $c = is_array($v) ? (int)($v['c'] ?? 1) : 1;
          if (!isset($agg[$h])) $agg[$h] = ['uv' => $h, 'c' => 0, 'last' => $d];
          $agg[$h]['c'] += $c;
          if ($d > $agg[$h]['last']) $agg[$h]['last'] = $d;
        }
      }
      $rows = array_values($agg);
      usort($rows, function ($a, $b) { return $b['c'] <=> $a['c']; });
      $total = count($rows);
      $rows = array_slice($rows, ($page - 1) * $pageSize, $pageSize);
      vst_json_out(['ok' => true, 'rows' => $rows, 'total' => $total, 'kind' => 'uv']);
    }

    // ip:完整 IP 明细聚合(IPv4/IPv6 全量,含次数与最后访问时间,附掩码形态)
    $agg = [];
    foreach ($db['days'] as $d => $day) {
      if (!$inScope($d)) continue;
      foreach ($day['ipsFull'] ?? [] as $ip => $v) {
        if (!isset($agg[$ip])) $agg[$ip] = ['ip' => $ip, 'mask' => vst_ip_mask($ip), 'c' => 0, 'last' => 0];
        $agg[$ip]['c'] += (int)($v['c'] ?? 1);
        $agg[$ip]['last'] = max($agg[$ip]['last'], (int)($v['last'] ?? 0));
      }
    }
    $rows = array_values($agg);
    usort($rows, function ($a, $b) { return $b['c'] <=> $a['c']; });
    $total = count($rows);
    $rows = array_slice($rows, ($page - 1) * $pageSize, $pageSize);
    // 归属地只查当页行(分页后),避免跨页全量外呼;前缀级缓存命中后开销极低
    foreach ($rows as &$r) $r['region'] = vst_region($r['ip']);
    unset($r);
    vst_json_out(['ok' => true, 'rows' => $rows, 'total' => $total, 'kind' => 'ip']);
  }

  case 'recent': {
    $page = max(1, (int)($in['page'] ?? 1));
    $pageSize = min(100, max(1, (int)($in['pageSize'] ?? 20)));
    $rows = array_slice($db['recent'], ($page - 1) * $pageSize, $pageSize);
    // 归属地只查当页行,前缀级缓存命中后开销极低
    foreach ($rows as &$r) $r['region'] = vst_region((string)($r['f'] ?? $r['ip'] ?? ''));
    unset($r);
    vst_json_out(['ok' => true, 'rows' => $rows, 'total' => count($db['recent'])]);
  }

  case 'purge':
    vst_db_save(vst_db_default());
    vst_json_out(['ok' => true]);

  default:
    vst_fail('未知动作');
}
